# Copia este archivo a .env y rellena los valores de tu proyecto de Supabase.
# Estos valores generan config.js con `node scripts/generate-config.mjs`.

# Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Project Settings -> API -> Project API keys -> anon public
# Es una clave publica: la seguridad real la aplican las politicas RLS.
SUPABASE_ANON_KEY=

# Ponlo en true solo cuando hayas configurado el proveedor de Google en Supabase.
GOOGLE_AUTH_ENABLED=false
